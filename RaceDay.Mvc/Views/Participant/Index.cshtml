@model IEnumerable<RaceDay.Mvc.Models.EventItem>
@{
    ViewData["Title"] = "Upcoming Events";
}

<h1 class="h3 fw-bold mb-3">Upcoming Events</h1>

<form method="get" class="card border-0 shadow-sm p-3 mb-4">
    <div class="row g-2">
        <div class="col-md-4">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or description..." />
        </div>
        <div class="col-md-3">
            <select name="eventType" class="form-select">
                <option value="">All Event Types</option>
                <option value="Run" selected="@(ViewBag.EventType == "Run")">Run</option>
                <option value="Trail" selected="@(ViewBag.EventType == "Trail")">Trail</option>
                <option value="Cycle" selected="@(ViewBag.EventType == "Cycle")">Cycle</option>
                <option value="Walk" selected="@(ViewBag.EventType == "Walk")">Walk</option>
                <option value="Triathlon" selected="@(ViewBag.EventType == "Triathlon")">Triathlon</option>
            </select>
        </div>
        <div class="col-md-3">
            <input type="text" name="location" value="@ViewBag.Location" class="form-control" placeholder="Filter by location..." />
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-raceday">Filter</button>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No events match your current filters.</div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card card-event h-100 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(ev.BannerImageUrl))
                    {
                        <img src="@ev.BannerImageUrl" class="card-img-top" alt="@ev.Name" style="height: 165px; object-fit: cover;" />
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="badge bg-dark">@ev.EventType</span>
                            <span class="badge bg-warning text-dark">@ev.Distance km</span>
                        </div>
                        <h5 class="card-title fw-bold">@ev.Name</h5>
                        <p class="card-text text-muted small flex-grow-1">@ev.Description</p>
                        <div class="small text-secondary mb-3">
                            <div><strong>Date:</strong> @ev.Date.ToString("dd MMM yyyy")</div>
                            <div><strong>Location:</strong> @ev.Location</div>
                        </div>
                        <a class="btn btn-raceday btn-sm w-100" asp-action="EventDetails" asp-route-id="@ev.Id">View & Enter</a>
                    </div>
                </div>
            </div>
        }
    </div>
}