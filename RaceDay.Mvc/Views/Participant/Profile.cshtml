@model RaceDay.Mvc.Models.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<h1 class="h3 fw-bold mb-4">My Profile</h1>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-4 text-center">
            @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" alt="@Model.FullName" class="rounded-circle mx-auto mb-3" style="width: 120px; height: 120px; object-fit: cover;" />
            }
            else
            {
                <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center mx-auto mb-3 fs-2 fw-bold" style="width: 120px; height: 120px;">
                    @(Model.FullName.FirstOrDefault().ToString().ToUpper())
                </div>
            }
            <h5 class="fw-bold mb-1">@Model.FullName</h5>
            <div class="text-muted small mb-2">@Model.Email</div>
            <span class="badge bg-secondary">@Model.Role</span>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm p-4">
            <h5 class="fw-bold mb-3">Update Details & Avatar</h5>
            <form asp-action="Profile" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Role" />
                <input type="hidden" asp-for="ProfilePictureUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ProfilePictureFile" class="form-label">Profile Picture (uploaded via API to Azure Blob Storage)</label>
                    <input asp-for="ProfilePictureFile" class="form-control" type="file" accept="image/*" />
                </div>

                <button type="submit" class="btn btn-raceday">Save Profile</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}