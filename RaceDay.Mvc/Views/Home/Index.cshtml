@model IEnumerable<RaceDay.Mvc.Models.EventItem>
@{
    ViewData["Title"] = "Upcoming Races";
}

<div class="p-4 p-md-5 mb-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 65%, #7c2d12 100%);">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1 class="display-5 fw-bold mb-2">Line Up. Race Hard. Own Your Finish.</h1>
            <p class="lead text-light opacity-90 mb-4">
                Discover road runs, trail challenges, cycling races, and multisport events—or host and manage your own race day.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-raceday btn-lg" asp-controller="Account" asp-action="Register">Get Started</a>
                <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Sign In</a>
            </div>
        </div>
    </div>
</div>

<h2 class="h4 fw-bold mb-3">Upcoming Events</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">No upcoming events have been published yet. Log in as an Organiser to create the first race!</div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card card-event h-100 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(ev.BannerImageUrl))
                    {
                        <img src="@ev.BannerImageUrl" class="card-img-top" alt="@ev.Name" style="height: 170px; object-fit: cover;" />
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-dark">@ev.EventType</span>
                            <span class="badge bg-warning text-dark">@ev.Distance km</span>
                        </div>
                        <h5 class="card-title fw-bold">@ev.Name</h5>
                        <p class="card-text text-muted small flex-grow-1">@ev.Description</p>
                        <div class="small text-secondary mb-3">
                            <div><strong>Date:</strong> @ev.Date.ToString("dd MMM yyyy")</div>
                            <div><strong>Location:</strong> @ev.Location</div>
                        </div>
                        <a class="btn btn-outline-dark btn-sm w-100" asp-controller="Account" asp-action="Login">Sign in to Enter</a>
                    </div>
                </div>
            </div>
        }
    </div>
}