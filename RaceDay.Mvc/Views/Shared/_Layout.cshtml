@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var role = HttpContextAccessor.HttpContext?.Session.GetString("UserRole");
    var email = HttpContextAccessor.HttpContext?.Session.GetString("UserEmail");
    var isOrganiser = string.Equals(role, "Organiser", StringComparison.OrdinalIgnoreCase);
    var isParticipant = string.Equals(role, "Participant", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            :root {
                --rd-primary: #0f172a;
                --rd-accent: #ea580c;
                --rd-accent-hover: #c2410c;
            }
            body {
                background-color: #f8fafc;
                color: #0f172a;
                font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            }
            .navbar-raceday {
                background: linear-gradient(90deg, #0f172a 0%, #1e293b 100%);
                border-bottom: 3px solid var(--rd-accent);
            }
            .navbar-raceday .navbar-brand {
                font-weight: 800;
                letter-spacing: 0.5px;
                color: #ffffff !important;
            }
            .navbar-raceday .brand-accent {
                color: #fb923c;
            }
            .navbar-raceday .nav-link {
                color: #e2e8f0 !important;
                font-weight: 500;
            }
            .navbar-raceday .nav-link:hover {
                color: #fb923c !important;
            }
            .btn-raceday {
                background-color: var(--rd-accent);
                border-color: var(--rd-accent);
                color: #fff;
                font-weight: 600;
            }
            .btn-raceday:hover {
                background-color: var(--rd-accent-hover);
                border-color: var(--rd-accent-hover);
                color: #fff;
            }
            .card-event {
                border: 1px solid #e2e8f0;
                border-radius: 12px;
                transition: transform 0.15s ease, box-shadow 0.15s ease;
            }
            .card-event:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-raceday shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    RACE<span class="brand-accent">DAY</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (isOrganiser)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events">My Events</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="CreateEvent">Create Event</a></li>
                        }
                        else if (isParticipant)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Index">Upcoming Events</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My Events</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My Results</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Explore Races</a></li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrEmpty(role))
                        {
                            <span class="badge bg-warning text-dark">@role</span>
                            <span class="text-light small d-none d-md-inline me-2">@email</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-light">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Login</a>
                            <a class="btn btn-sm btn-raceday" asp-controller="Account" asp-action="Register">Register</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container pb-5">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                @TempData["WarningMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>