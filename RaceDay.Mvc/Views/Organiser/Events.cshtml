@model IEnumerable<RaceDay.Mvc.Models.EventItem>
@{
    ViewData["Title"] = "My Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0">My Events</h1>
    <a class="btn btn-raceday" asp-action="CreateEvent">+ Create Event</a>
</div>

<div class="row g-4">
    @foreach (var ev in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card card-event h-100 shadow-sm">
                @if (!string.IsNullOrWhiteSpace(ev.BannerImageUrl))
                {
                    <img src="@ev.BannerImageUrl" class="card-img-top" alt="@ev.Name" style="height: 160px; object-fit: cover;" />
                }
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="badge bg-dark">@ev.EventType</span>
                        <span class="badge bg-warning text-dark">@ev.Distance km</span>
                    </div>
                    <h5 class="card-title fw-bold">@ev.Name</h5>
                    <p class="card-text text-muted small flex-grow-1">@ev.Description</p>
                    <div class="small text-secondary mb-3">
                        <div><strong>Date:</strong> @ev.Date.ToString("dd MMM yyyy")</div>
                        <div><strong>Location:</strong> @ev.Location</div>
                        <div><strong>Categories:</strong> @ev.Categories.Count</div>
                    </div>
                    <div class="d-flex flex-wrap gap-1">
                        <a class="btn btn-sm btn-outline-dark" asp-action="EditEvent" asp-route-id="@ev.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Categories" asp-route-eventId="@ev.Id">Categories</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Enrolments" asp-route-eventId="@ev.Id">Enrolments</a>
                        <a class="btn btn-sm btn-outline-success" asp-action="Results" asp-route-eventId="@ev.Id">Results</a>
                        <form asp-action="DeleteEvent" asp-route-id="@ev.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this event?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>