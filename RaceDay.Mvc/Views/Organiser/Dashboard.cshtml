@model IEnumerable<RaceDay.Mvc.Models.EventItem>
@{
    ViewData["Title"] = "Organiser Dashboard";
    var counts = ViewBag.EnrolmentCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var totalEnrolments = counts.Values.Sum();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-0">Organiser Dashboard</h1>
        <p class="text-muted small mb-0">Overview of your races, participant entries, and upcoming dates.</p>
    </div>
    <a class="btn btn-raceday" asp-action="CreateEvent">+ Create Event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small">My Events</div>
            <div class="fs-2 fw-bold">@Model.Count()</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small">Total Enrolments</div>
            <div class="fs-2 fw-bold">@totalEnrolments</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3">
            <div class="text-muted small">Next Race Date</div>
            <div class="fs-5 fw-bold mt-2">
                @(Model.Where(e => e.Date >= DateTime.Today).OrderBy(e => e.Date).FirstOrDefault()?.Date.ToString("dd MMM yyyy") ?? "None scheduled")
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-bold py-3">Your Events</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Enrolments</th>
                    <th class="text-end">Manage</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No events created yet.</td></tr>
                }
                else
                {
                    @foreach (var ev in Model)
                    {
                        var count = counts.ContainsKey(ev.Id) ? counts[ev.Id] : 0;
                        <tr>
                            <td class="fw-semibold">@ev.Name</td>
                            <td>@ev.Date.ToString("dd MMM yyyy")</td>
                            <td>@ev.Location</td>
                            <td><span class="badge bg-primary">@count</span></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Categories" asp-route-eventId="@ev.Id">Categories</a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Enrolments" asp-route-eventId="@ev.Id">Enrolments</a>
                                <a class="btn btn-sm btn-outline-success" asp-action="Results" asp-route-eventId="@ev.Id">Results</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>