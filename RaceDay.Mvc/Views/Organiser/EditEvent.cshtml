@model RaceDay.Mvc.Models.EventFormViewModel
@{
    ViewData["Title"] = "Edit Event";
}

<h1 class="h3 fw-bold mb-4">Edit Event</h1>

<div class="card border-0 shadow-sm col-lg-8">
    <div class="card-body p-4">
        <form asp-action="EditEvent" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="BannerImageUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
            {
                <div class="mb-3">
                    <label class="form-label d-block">Current Banner</label>
                    <img src="@Model.BannerImageUrl" alt="@Model.Name" class="rounded" style="max-height: 160px; object-fit: cover;" />
                </div>
            }

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="Date" class="form-label"></label>
                    <input asp-for="Date" class="form-control" type="date" />
                    <span asp-validation-for="Date" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Distance" class="form-label">Distance (km)</label>
                    <input asp-for="Distance" class="form-control" type="number" step="0.1" />
                    <span asp-validation-for="Distance" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EventType" class="form-label"></label>
                    <select asp-for="EventType" class="form-select">
                        <option value="Run">Run</option>
                        <option value="Trail">Trail</option>
                        <option value="Cycle">Cycle</option>
                        <option value="Walk">Walk</option>
                        <option value="Triathlon">Triathlon</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="BannerFile" class="form-label">Replace Banner Image</label>
                <input asp-for="BannerFile" class="form-control" type="file" accept="image/*" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-raceday">Save Changes</button>
                <a class="btn btn-outline-secondary" asp-action="Events">Back to Events</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}